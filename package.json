{
  "name": "@francescomalatesta/laravel-forge-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the Laravel Forge API",
  "type": "module",
  "bin": {
    "laravel-forge-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage:api": "tsx scripts/coverage.ts",
    "generate:types": "openapi-typescript spec/forge.openapi.json -o src/forge/schema.gen.ts",
    "spec:update": "tsx scripts/update-spec.ts && npm run generate:types",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "check": "npm run typecheck && npm test && npm run coverage:api"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
